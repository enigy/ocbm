# identity.list — unit identity Stage A archives to /etc/ocbm/identity.tgz before it changes
# anything (with the Wi-Fi and Bluetooth addresses in /etc/ocbm/addresses.txt). Relative to /;
# missing entries are skipped. The archive holds the Wi-Fi passphrase, Bluetooth link keys and
# iPhone pairing records: it must never reach a log, an issue or a repo.
etc/riddle.conf
etc/hostapd.conf
etc/bluetooth
etc/bluetooth_name
# Stock's custom Bluetooth name flag. OCBM's seam writes its own name into it (and into
# etc/bluetooth_name): ocbm_revert.sh puts back the one the install found, or removes the seam's.
etc/.custom_bluetooth_name
etc/wifi_name
etc/box_name
etc/device_serial
etc/serial_number
etc/factory_name
etc/manufacture_date
etc/.manufacture_date_sign
etc/uuid_sign
var/lib/lockdown
# The unit's HiCar identity (keystore and device info). The prune empties etc/hichain with HiCar,
# and Carlinkit's own image ships only an empty etc/hichain: ocbm_revert.sh puts it back from here.
etc/hichain
